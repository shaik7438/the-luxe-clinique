# Public canonical URL used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.luxeclinique.com

# Optional: HTTPS endpoint that receives appointment enquiries as JSON (POST).
# e.g. a Zapier/Make webhook, a CRM intake URL, or your own email relay.
# When unset in production, the form tells visitors honestly that online
# enquiries are not connected and offers phone / email / WhatsApp instead.
ENQUIRY_WEBHOOK_URL=

# Optional: path or URL to a production GLB of the hero treatment scene.
# When set, it replaces the procedural stylised scene. Keep it Draco/meshopt
# compressed and under ~3 MB.
NEXT_PUBLIC_HERO_GLB=

# Shared secret sent with each enquiry; must match SECRET in scripts/enquiry-apps-script.gs.
ENQUIRY_WEBHOOK_SECRET=

# Google Search Console HTML-tag verification code (the content= value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics stays off until this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
